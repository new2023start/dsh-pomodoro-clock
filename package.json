{
  "name": "dsh-pomodoro-clock",
  "version": "1.0.0",
  "type": "module",
  "description": "A pomodoro timer for the DeepSeek Harness right sidebar: a draggable edge handle, one-shot or cycle counting, and selectable chimes including an airport-style announcement.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "harness",
    "pomodoro",
    "timer",
    "focus",
    "sidebar",
    "plugin"
  ],
  "author": "new2023start",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/new2023start/dsh-pomodoro-clock.git"
  },
  "homepage": "https://github.com/new2023start/dsh-pomodoro-clock#readme",
  "bugs": {
    "url": "https://github.com/new2023start/dsh-pomodoro-clock/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
